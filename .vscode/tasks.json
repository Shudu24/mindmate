{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Mindmate server",
            "type": "shell",
            "command": "javac",
            "args": [
                "-encoding",
                "UTF-8",
                "-cp",
                "../lib/*",
                "-d",
                "out",
                "src/mindmate/*.java",
                "src/mindmate/db/*.java",
                "src/mindmate/model/*.java",
                "src/mindmate/dao/*.java",
                "src/mindmate/http/*.java",
                "src/mindmate/util/*.java"
            ],
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "problemMatcher": [
                "$javac"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
